# ============================================================================
#  Modele du fichier .env lu automatiquement par docker compose.
#
#  A copier en « .env » a cote de docker-compose.yml, puis a remplir.
#  Le vrai fichier n'est JAMAIS versionne (voir .gitignore) : il contient les
#  mots de passe de la base.
#
#  Sur le NAS, ce fichier vit dans /volume1/docker/STLExplorer/.env, en 600
#  root:root. Les mots de passe y ont ete generes lors de la rotation du
#  14/09/2026 ; les anciens, presents dans l'historique git, ne donnent plus
#  acces a rien.
# ============================================================================

# Compte administrateur de MariaDB.
MYSQL_ROOT_PASSWORD=

# Compte utilise par l'API (droits limites a la base de l'application).
MYSQL_PASSWORD=
MYSQL_USER=florent
MYSQL_DATABASE=StlExplorerServer
