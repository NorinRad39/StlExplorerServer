<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StlExplorerClient.ConfigPage"
             Title="Configuration">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <!-- ========== Adresse du serveur ========== -->
            <Label Text="Adresse du serveur" Style="{StaticResource Titre}" />

            <Label Text="URL ou IP du serveur API (ex: http://192.168.20.253:5182). Le changement est appliqué immédiatement." Style="{StaticResource Secondaire}" />

            <Grid ColumnDefinitions="*, 140" ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource Champ}">
                    <Entry x:Name="ServerUrlEntry"
                           Placeholder="http://192.168.20.253:5182"
                           Keyboard="Url" />
                </Border>
                <Button Grid.Column="1"
                        Text="Appliquer" Style="{StaticResource Principal}"
                        Clicked="OnAppliquerUrlClicked" />
            </Grid>

            <Label x:Name="UrlStatusLabel"
                   Text=""
                   TextColor="{StaticResource Succes}"
                   FontSize="13" />

            <BoxView HeightRequest="1" Margin="0,5" />

            <!-- ========== Dossiers racines ========== -->
            <Label Text="Dossiers racines à scanner" Style="{StaticResource Titre}" />

            <Label Text="Liste des dossiers racines configurés sur le serveur pour l'indexation des fichiers STL sur le NAS." Style="{StaticResource Secondaire}" />

            <Border Padding="10"
                    HeightRequest="150">
                <CollectionView x:Name="DirectoriesCollectionView" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*, 70" Padding="5,4">
                                <Label Grid.Column="0"
                                       Text="{Binding .}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Retirer"
                                        Style="{StaticResource Danger}"
                                        FontSize="12"
                                        Padding="0"
                                        WidthRequest="70"
                                        HeightRequest="34"
                                        Clicked="OnSupprimerDossierClicked"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="Aucun dossier configuré"
                               Style="{StaticResource Secondaire}"
                               HorizontalOptions="Center"
                               Margin="0,20" />
                    </CollectionView.EmptyView>
                </CollectionView>
            </Border>

            <Grid ColumnDefinitions="*, Auto, 120" ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource Champ}">
                    <Entry x:Name="NouveauDossierEntry"
                           Placeholder="Chemin UNC (ex: \\192.168...)" />
                </Border>
                <Button x:Name="BtnParcourir"
                        Grid.Column="1"
                        Text="Parcourir"
                        Padding="15,0"
                        IsVisible="False"
                        Clicked="OnParcourirDossierClicked" />
                <Button Grid.Column="2"
                        Text="Ajouter" Style="{StaticResource Principal}"
                        Clicked="OnAjouterDossierClicked" />
            </Grid>

            <HorizontalStackLayout Spacing="15" Margin="0,10,0,0">
                <Button x:Name="BtnEnregistrer"
                        Text="Enregistrer" Style="{StaticResource Principal}"
                        Padding="20,0"
                        Clicked="OnEnregistrerClicked" />
                <Button x:Name="BtnRelancerScan"
                        Text="Relancer le scan"
                        Padding="20,0"
                        Clicked="OnRelancerScanClicked" />
            </HorizontalStackLayout>

            <Label x:Name="StatusLabel"
                   Text=""
                   TextColor="{StaticResource Succes}"
                   FontSize="13" />

            <!-- Mise à jour de l'application -->
            <BoxView HeightRequest="1" Margin="0,15,0,5" />

            <Label Text="Mise à jour de l'application" Style="{StaticResource TitreSection}" />

            <HorizontalStackLayout Spacing="15">
                <Button x:Name="BtnVerifierMaj"
                        Text="Vérifier les mises à jour"
                        Padding="20,0"
                        Clicked="OnVerifierMajClicked" />
                <Label x:Name="VersionLabel"
                       Text=""
                       Style="{StaticResource Secondaire}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
