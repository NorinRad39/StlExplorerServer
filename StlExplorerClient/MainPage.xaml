<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:StlExplorerClient"
             x:Class="StlExplorerClient.MainPage"
             Title="Catalogue"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <local:PlateauDrawable x:Key="PlateauDrawable" />
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête : fil d'Ariane (famille / sujet / modèle) et boutons globaux -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*, Auto, Auto"
              ColumnSpacing="8"
              Padding="16,10">
            <Label x:Name="FilArianeLabel"
                   Grid.Column="0"
                   Style="{StaticResource Titre}"
                   FontSize="18"
                   LineBreakMode="HeadTruncation"
                   MaxLines="1"
                   VerticalOptions="Center"
                   Text="Catalogue" />
            <Button x:Name="BtnMenuActions"
                    Grid.Column="1"
                    Text="Actions"
                    IsVisible="False"
                    Clicked="OnMenuActionsClicked" />
            <Button Grid.Column="2"
                    Text="Config"
                    Clicked="OnConfigClicked" />
        </Grid>

        <VerticalStackLayout Grid.Row="1">
        <!-- Menu des actions (Windows) : replié par défaut, ouvert par le bouton « Actions » -->
        <Border x:Name="ActionsMenuPanel"
                IsVisible="False"
                Margin="16,0,16,8"
                Padding="10">
            <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                <Button x:Name="BtnCreerDossier"
                        Text="Créer le dossier"
                        Margin="0,0,8,0"
                        IsVisible="False"
                        Clicked="OnCreerDossierClicked" />
                <Button x:Name="BtnAjouterFichiers"
                        Text="Ajouter des fichiers"
                        Margin="0,0,8,0"
                        IsVisible="False"
                        Clicked="OnAjouterFichiersClicked" />
                <Button x:Name="BtnRenommerModele"
                        Text="Renommer"
                        Margin="0,0,8,0"
                        IsVisible="False"
                        Clicked="OnRenommerModeleClicked" />
                <Button x:Name="BtnOuvrirExplorateur"
                        Text="Ouvrir le dossier"
                        Margin="0,0,8,0"
                        IsVisible="False"
                        Clicked="OnOuvrirExplorateurClicked" />
                <Button x:Name="BtnActualiserBase"
                        Text="Actualiser la base"
                        Clicked="OnActualiserBaseClicked" />
            </FlexLayout>
        </Border>

        <!-- Bannière de progression du scan (visible uniquement pendant un scan) -->
        <Border x:Name="ScanProgressPanel"
                IsVisible="False"
                BackgroundColor="{StaticResource ResineFond}"
                Margin="16,0,16,8"
                Padding="12,8">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">
                <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label x:Name="ScanPhaseLabel"
                               Grid.Column="0"
                               Text="Analyse en cours"
                               TextColor="{StaticResource Resine}"
                               FontFamily="TexteBold"
                               FontSize="13" />
                        <Label x:Name="ScanEtaLabel"
                               Grid.Column="1"
                               Text=""
                               Style="{StaticResource Secondaire}"
                               FontSize="12"
                               VerticalOptions="Center" />
                    </Grid>
                    <ProgressBar x:Name="ScanProgressBar" Progress="0" />
                </VerticalStackLayout>
                <Label x:Name="ScanPercentLabel"
                       Grid.Column="1"
                       Text="0%"
                       Style="{StaticResource Titre}"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        </VerticalStackLayout>
        <!-- Corps : deux colonnes (navigation | plateau) sur grand écran, une seule sur
             téléphone ou fenêtre étroite. La disposition est recalculée dans le code
             (AdapterDisposition). -->
        <Grid x:Name="Corps" Grid.Row="2" ColumnSpacing="0" RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColonneA" Width="340" />
                <ColumnDefinition x:Name="ColonneB" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="LigneA" Height="*" />
                <RowDefinition x:Name="LigneB" Height="0" />
            </Grid.RowDefinitions>

            <!-- ============ Navigation ============ -->
            <Grid x:Name="NavColonne" Grid.Row="0" Grid.Column="0" RowDefinitions="*, Auto">
                <ScrollView x:Name="ScrollPrincipal" Grid.Row="0">
                    <VerticalStackLayout x:Name="ContenuPrincipal" Spacing="12" Padding="16,4,16,12">

                        <!-- Famille / Sujet / Modèle : champs avec liste de suggestions -->
                        <Grid RowSpacing="4" ColumnSpacing="10" HorizontalOptions="Fill">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Text="Famille" Style="{StaticResource Secondaire}" VerticalOptions="Center" />
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Champ}">
                                <Grid ColumnDefinitions="*, 30, 35">
                                    <Entry x:Name="FamilleEntry" Grid.Column="0" Placeholder="Saisir ou choisir" TextChanged="OnFamilleTextChanged" />
                                    <Button Grid.Column="1" Text="✕" FontSize="11" Style="{StaticResource Discret}" Clicked="OnFamilleClearClicked" />
                                    <Button Grid.Column="2" Text="&#x25BC;" FontSize="12" Style="{StaticResource Discret}" Clicked="OnFamilleDropdownClicked" />
                                </Grid>
                            </Border>
                            <Border x:Name="FamilleListContainer" Grid.Row="1" Grid.Column="1" IsVisible="False" HeightRequest="120" Padding="0">
                                <CollectionView x:Name="FamilleCollectionView" SelectionMode="Single" SelectionChanged="OnFamilleSelectionChanged">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Label Text="{Binding .}" Padding="10,8" />
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Border>

                            <Label Grid.Row="2" Grid.Column="0" Text="Sujet" Style="{StaticResource Secondaire}" VerticalOptions="Center" />
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Champ}">
                                <Grid ColumnDefinitions="*, 30, 35">
                                    <Entry x:Name="SujetEntry" Grid.Column="0" Placeholder="Saisir ou choisir" TextChanged="OnSujetTextChanged" />
                                    <Button Grid.Column="1" Text="✕" FontSize="11" Style="{StaticResource Discret}" Clicked="OnSujetClearClicked" />
                                    <Button Grid.Column="2" Text="&#x25BC;" FontSize="12" Style="{StaticResource Discret}" Clicked="OnSujetDropdownClicked" />
                                </Grid>
                            </Border>
                            <Border x:Name="SujetListContainer" Grid.Row="3" Grid.Column="1" IsVisible="False" HeightRequest="120" Padding="0">
                                <CollectionView x:Name="SujetCollectionView" SelectionMode="Single" SelectionChanged="OnSujetSelectionChanged">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Label Text="{Binding .}" Padding="10,8" />
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Border>

                            <Label Grid.Row="4" Grid.Column="0" Text="Modèle" Style="{StaticResource Secondaire}" VerticalOptions="Center" />
                            <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource Champ}">
                                <Grid ColumnDefinitions="*, 30, 35">
                                    <Entry x:Name="ModeleEntry" Grid.Column="0" Placeholder="Saisir ou choisir" TextChanged="OnModeleTextChanged" />
                                    <Button Grid.Column="1" Text="✕" FontSize="11" Style="{StaticResource Discret}" Clicked="OnModeleClearClicked" />
                                    <Button Grid.Column="2" Text="&#x25BC;" FontSize="12" Style="{StaticResource Discret}" Clicked="OnModeleDropdownClicked" />
                                </Grid>
                            </Border>
                            <Border x:Name="ModeleListContainer" Grid.Row="5" Grid.Column="1" IsVisible="False" HeightRequest="120" Padding="0">
                                <CollectionView x:Name="ModeleCollectionView" SelectionMode="Single" SelectionChanged="OnModeleSelectionChanged">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Label Text="{Binding .}" Padding="10,8" />
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Border>
                        </Grid>

                        <!-- Modèle précédent / suivant dans le sujet (boutons ou flèches ◀ ▶ du clavier) -->
                        <Grid x:Name="ModeleNavPanel"
                              IsVisible="False"
                              ColumnDefinitions="Auto, Auto, *"
                              ColumnSpacing="8">
                            <Button x:Name="BtnModelePrecedent"
                                    Grid.Column="0"
                                    Text="&#x25C0;"
                                    WidthRequest="48"
                                    ToolTipProperties.Text="Modèle précédent (flèche gauche du clavier)"
                                    Clicked="OnModelePrecedentClicked" />
                            <Button x:Name="BtnModeleSuivant"
                                    Grid.Column="1"
                                    Text="&#x25B6;"
                                    WidthRequest="48"
                                    ToolTipProperties.Text="Modèle suivant (flèche droite du clavier)"
                                    Clicked="OnModeleSuivantClicked" />
                            <Label x:Name="ModeleNavLabel"
                                   Grid.Column="2"
                                   Text=""
                                   Style="{StaticResource Secondaire}"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Contenu du dossier (fichiers et sous-dossiers à la racine) -->
                        <Border x:Name="ContenuDossierPanel" IsVisible="False" Padding="12,10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Contenu du dossier" Style="{StaticResource TitreSection}" />
                                <CollectionView x:Name="ContenuDossierCollectionView" HeightRequest="100">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <!-- CharacterWrap : un nom de fichier long sans espace doit
                                                 revenir à la ligne au lieu d'élargir la liste. -->
                                            <Label Text="{Binding .}" Padding="0,3" Style="{StaticResource Secondaire}" LineBreakMode="CharacterWrap" />
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Fichiers 3D détectés (cliquables pour l'aperçu) -->
                        <Border x:Name="Fichiers3DPanel" IsVisible="False" Padding="12,10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Fichiers 3D" Style="{StaticResource TitreSection}" />
                                <CollectionView x:Name="Fichiers3DCollectionView" HeightRequest="120" SelectionMode="Single" SelectionChanged="OnFichier3DSelectionChanged">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Chemins d'archive sans espace : CharacterWrap évite
                                                 qu'ils élargissent la liste. -->
                                            <Label Text="{Binding Affichage}" Padding="0,4" Style="{StaticResource Lien}" LineBreakMode="CharacterWrap" />
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- Action principale (Windows) -->
                <VerticalStackLayout x:Name="WindowsActionsPanel" Grid.Row="1" IsVisible="False" Padding="16,8,16,12">
                    <Button x:Name="BtnTeleverserDossier"
                            Text="Téléverser un dossier"
                            Style="{StaticResource Principal}"
                            IsVisible="False"
                            ToolTipProperties.Text="Copier un dossier déjà nommé (et tout son contenu) dans Famille &gt; Sujet. Vous pouvez aussi le glisser sur le plateau."
                            Clicked="OnTeleverserDossierClicked" />
                </VerticalStackLayout>
            </Grid>

            <!-- ============ Scène : plateau d'impression ============ -->
            <Grid x:Name="SceneColonne" Grid.Row="0" Grid.Column="1" RowDefinitions="Auto, *" RowSpacing="8" Padding="16,4,16,12">

                <!-- Progression d'une copie de fichiers ou de dossier -->
                <Border x:Name="UploadProgressPanel"
                        Grid.Row="0"
                        IsVisible="False"
                        BackgroundColor="{StaticResource ResineFond}"
                        Padding="12,8">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label x:Name="UploadPhaseLabel"
                                   Grid.Column="0"
                                   Text=""
                                   TextColor="{StaticResource Resine}"
                                   FontFamily="TexteBold"
                                   FontSize="13"
                                   LineBreakMode="TailTruncation" />
                            <Label x:Name="UploadPercentLabel"
                                   Grid.Column="1"
                                   Text=""
                                   FontFamily="TexteBold"
                                   FontSize="13" />
                        </Grid>
                        <ProgressBar x:Name="UploadProgressBar" Progress="0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Le plateau : grille et repères d'angle dessinés derrière l'aperçu -->
                <Border x:Name="ApercuBorder"
                        Grid.Row="1"
                        BackgroundColor="{StaticResource PlateauFond}"
                        Padding="0"
                        MinimumHeightRequest="220"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                    <Border.GestureRecognizers>
                        <DropGestureRecognizer AllowDrop="True"
                                               DragOver="OnDossierDragOver"
                                               DragLeave="OnDossierDragLeave"
                                               Drop="OnDossierDrop" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <GraphicsView Drawable="{StaticResource PlateauDrawable}" InputTransparent="True" />
                        <Image x:Name="ModeleImage" Aspect="AspectFit" Margin="22">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnImageTapped" />
                            </Image.GestureRecognizers>
                        </Image>
                        <WebView x:Name="Viewer3DWebView" IsVisible="False" />

                        <!-- Flèches et compteur posés sur le plateau ; le reste du
                             calque laisse passer les clics vers l'image ou le viewer. -->
                        <Grid x:Name="ImageNavPanel"
                              InputTransparent="True"
                              CascadeInputTransparent="False"
                              ColumnDefinitions="Auto, *, Auto"
                              RowDefinitions="*, Auto"
                              Padding="26,0,26,22">
                            <Button x:Name="BtnImagePrecedente"
                                    Grid.Row="0" Grid.Column="0"
                                    Text="&#x25C0;"
                                    BackgroundColor="#D91B1D1C"
                                    WidthRequest="40"
                                    HeightRequest="56"
                                    Padding="0"
                                    VerticalOptions="Center"
                                    ToolTipProperties.Text="Image précédente (flèche haut du clavier)"
                                    Clicked="OnImagePrecedenteClicked" />
                            <Button x:Name="BtnImageSuivante"
                                    Grid.Row="0" Grid.Column="2"
                                    Text="&#x25B6;"
                                    BackgroundColor="#D91B1D1C"
                                    WidthRequest="40"
                                    HeightRequest="56"
                                    Padding="0"
                                    VerticalOptions="Center"
                                    ToolTipProperties.Text="Image suivante (flèche bas du clavier)"
                                    Clicked="OnImageSuivanteClicked" />
                            <Label x:Name="ImageCounterLabel"
                                   Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                   InputTransparent="True"
                                   Text=""
                                   Style="{StaticResource Secondaire}"
                                   HorizontalOptions="Center" />
                        </Grid>

                        <!-- Retour aux images (visible quand le viewer 3D est actif) -->
                        <Button x:Name="BtnRetourImages"
                                Text="Retour aux images"
                                BackgroundColor="#D91B1D1C"
                                HorizontalOptions="Center"
                                VerticalOptions="Start"
                                Margin="0,22,0,0"
                                IsVisible="False"
                                Clicked="OnRetourImagesClicked" />

                        <!-- Zone de dépôt : n'apparaît que pendant un glisser-déposer au-dessus
                             du plateau. InputTransparent : le dépôt doit atterrir sur le plateau. -->
                        <Border x:Name="ZoneDepotDossier"
                                IsVisible="False"
                                InputTransparent="True"
                                Stroke="{StaticResource Ambre}"
                                StrokeThickness="2"
                                StrokeDashArray="6,4"
                                BackgroundColor="#E61B1D1C"
                                Margin="10"
                                Padding="15">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Label x:Name="ZoneDepotLabel"
                                   Text="Relâchez pour déplacer le dossier"
                                   Style="{StaticResource Titre}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Journal de debug (repliable) -->
        <Border x:Name="DebugLogPanel"
                Grid.Row="3"
                StrokeShape="RoundRectangle 0"
                StrokeThickness="0"
                Padding="0">
            <VerticalStackLayout>
                <BoxView HeightRequest="1" />
                <Grid Padding="16,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label Text="Journal de debug"
                           Style="{StaticResource Secondaire}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleDebugLogClicked" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Button x:Name="BtnClearDebugLog"
                            Grid.Column="1"
                            Text="Effacer"
                            FontSize="12"
                            Style="{StaticResource Discret}"
                            Padding="10,0"
                            Clicked="OnClearDebugLogClicked" />
                    <Button x:Name="BtnToggleDebugLog"
                            Grid.Column="2"
                            Text="▼"
                            FontSize="12"
                            Style="{StaticResource Discret}"
                            Padding="10,0"
                            Clicked="OnToggleDebugLogClicked" />
                </Grid>
                <ScrollView x:Name="DebugLogScrollView"
                            HeightRequest="180"
                            IsVisible="False">
                    <Label x:Name="DebugLogLabel"
                           Text=""
                           TextColor="{StaticResource Succes}"
                           FontSize="11"
                           FontFamily="Consolas"
                           Padding="16,5"
                           LineBreakMode="WordWrap" />
                </ScrollView>
            </VerticalStackLayout>
        </Border>

        <!-- Overlay plein écran pour agrandir l'image (clic pour fermer) -->
        <Grid x:Name="ImageOverlay" Grid.RowSpan="4" IsVisible="False" BackgroundColor="{StaticResource Voile}" ZIndex="100">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnImageOverlayTapped" />
            </Grid.GestureRecognizers>
            <Image x:Name="EnlargedImage" Aspect="AspectFit" Margin="30" />
            <Label Text="Cliquer pour fermer"
                   Style="{StaticResource Secondaire}"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="0,0,0,15" />
        </Grid>
    </Grid>

</ContentPage>
