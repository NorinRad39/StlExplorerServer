<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StlExplorerClient.MainPage"
             Title="Catalogue"
             BackgroundColor="#1E1E1E">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="⚙ Config" Clicked="OnConfigClicked" />
    </ContentPage.ToolbarItems>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
           <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Bannière de progression du scan (visible uniquement pendant un scan) -->
        <Border x:Name="ScanProgressPanel"
                Grid.Row="0"
                IsVisible="False"
                BackgroundColor="#1A3A5C"
                StrokeThickness="0"
                Padding="15,10">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">
                <VerticalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label x:Name="ScanPhaseLabel"
                               Grid.Column="0"
                               Text="Scan en cours..."
                               TextColor="#90CAF9"
                               FontSize="13"
                               FontAttributes="Bold" />
                        <Label x:Name="ScanEtaLabel"
                               Grid.Column="1"
                               Text=""
                               TextColor="#78909C"
                               FontSize="12"
                               VerticalOptions="Center" />
                    </Grid>
                    <ProgressBar x:Name="ScanProgressBar"
                                 Progress="0"
                                 ProgressColor="#2196F3" />
                </VerticalStackLayout>
                <Label x:Name="ScanPercentLabel"
                       Grid.Column="1"
                       Text="0%"
                       TextColor="White"
                       FontSize="22"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Contenu principal -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20">
                <!-- Marges resserrées sur téléphone : 30 px de chaque côté amputaient
                     un écran de ~360 dp d'un sixième de sa largeur utile. -->
                <VerticalStackLayout.Padding>
                    <OnIdiom x:TypeArguments="Thickness" Default="30" Phone="16,20" />
                </VerticalStackLayout.Padding>


                <!-- Formulaire hiérarchique avec ComboBox simulées -->
                <!-- Largeur adaptative : la colonne des champs s'étire jusqu'à 350 px sur
                     grand écran, et se réduit pour tenir sur la largeur d'un téléphone. -->
                <Grid RowSpacing="5" ColumnSpacing="15" HorizontalOptions="Fill" MaximumWidthRequest="445">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- Auto : la colonne des libellés prend la largeur du mot le plus
                             long (« Famille ») au lieu d'un 80 px figé. -->
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Ligne Famille -->
                    <Label Grid.Row="0" Grid.Column="0" Text="Famille" VerticalOptions="Center" TextColor="#E0E0E0" />
                    <Border Grid.Row="0" Grid.Column="1" Stroke="#555" StrokeThickness="1" HeightRequest="40" BackgroundColor="#383838" Padding="0">
                        <Grid ColumnDefinitions="*, 30, 35">
                            <Entry x:Name="FamilleEntry" Grid.Column="0" Placeholder="Saisir ou choisir..." TextColor="#E0E0E0" PlaceholderColor="#888" TextChanged="OnFamilleTextChanged" BackgroundColor="Transparent" />
                            <Button Grid.Column="1" Text="✕" FontSize="11" TextColor="#888" BackgroundColor="Transparent" Padding="0" Clicked="OnFamilleClearClicked" />
                            <Button Grid.Column="2" Text="&#x25BC;" FontSize="12" TextColor="#E0E0E0" BackgroundColor="Transparent" Padding="0" Clicked="OnFamilleDropdownClicked" />
                        </Grid>
                    </Border>
                    <Border x:Name="FamilleListContainer" Grid.Row="1" Grid.Column="1" IsVisible="False" HeightRequest="120" Stroke="#555" StrokeThickness="1" BackgroundColor="#2D2D2D">
                        <CollectionView x:Name="FamilleCollectionView" SelectionMode="Single" SelectionChanged="OnFamilleSelectionChanged">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}" Padding="10,8" TextColor="#E0E0E0" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>

                    <!-- Ligne Sujet -->
                    <Label Grid.Row="2" Grid.Column="0" Text="Sujet" VerticalOptions="Center" TextColor="#E0E0E0" />
                    <Border Grid.Row="2" Grid.Column="1" Stroke="#555" StrokeThickness="1" HeightRequest="40" BackgroundColor="#383838" Padding="0">
                        <Grid ColumnDefinitions="*, 30, 35">
                            <Entry x:Name="SujetEntry" Grid.Column="0" Placeholder="Saisir ou choisir..." TextColor="#E0E0E0" PlaceholderColor="#888" TextChanged="OnSujetTextChanged" BackgroundColor="Transparent" />
                            <Button Grid.Column="1" Text="✕" FontSize="11" TextColor="#888" BackgroundColor="Transparent" Padding="0" Clicked="OnSujetClearClicked" />
                            <Button Grid.Column="2" Text="&#x25BC;" FontSize="12" TextColor="#E0E0E0" BackgroundColor="Transparent" Padding="0" Clicked="OnSujetDropdownClicked" />
                        </Grid>
                    </Border>
                    <Border x:Name="SujetListContainer" Grid.Row="3" Grid.Column="1" IsVisible="False" HeightRequest="120" Stroke="#555" StrokeThickness="1" BackgroundColor="#2D2D2D">
                        <CollectionView x:Name="SujetCollectionView" SelectionMode="Single" SelectionChanged="OnSujetSelectionChanged">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}" Padding="10,8" TextColor="#E0E0E0" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>

                    <!-- Ligne Modèle -->
                    <Label Grid.Row="4" Grid.Column="0" Text="Modèle" VerticalOptions="Center" TextColor="#E0E0E0" />
                    <Border Grid.Row="4" Grid.Column="1" Stroke="#555" StrokeThickness="1" HeightRequest="40" BackgroundColor="#383838" Padding="0">
                        <Grid ColumnDefinitions="*, 30, 35">
                            <Entry x:Name="ModeleEntry" Grid.Column="0" Placeholder="Saisir ou choisir..." TextColor="#E0E0E0" PlaceholderColor="#888" TextChanged="OnModeleTextChanged" BackgroundColor="Transparent" />
                            <Button Grid.Column="1" Text="✕" FontSize="11" TextColor="#888" BackgroundColor="Transparent" Padding="0" Clicked="OnModeleClearClicked" />
                            <Button Grid.Column="2" Text="&#x25BC;" FontSize="12" TextColor="#E0E0E0" BackgroundColor="Transparent" Padding="0" Clicked="OnModeleDropdownClicked" />
                        </Grid>
                    </Border>
                    <Border x:Name="ModeleListContainer" Grid.Row="5" Grid.Column="1" IsVisible="False" HeightRequest="120" Stroke="#555" StrokeThickness="1" BackgroundColor="#2D2D2D">
                        <CollectionView x:Name="ModeleCollectionView" SelectionMode="Single" SelectionChanged="OnModeleSelectionChanged">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}" Padding="10,8" TextColor="#E0E0E0" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </Grid>

                <!-- Défilement rapide des modèles du sujet (boutons ou flèches ◀ ▶ du clavier).
                     Boutons compacts et libellé tronqué : sur téléphone, la largeur disponible
                     ne permet pas des boutons texte suivis d'un nom de modèle complet. -->
                <Grid x:Name="ModeleNavPanel"
                      IsVisible="False"
                      ColumnDefinitions="Auto, Auto, *"
                      ColumnSpacing="10"
                      HorizontalOptions="Fill"
                      MaximumWidthRequest="445">
                    <Button x:Name="BtnModelePrecedent"
                            Grid.Column="0"
                            Text="&#x25C0;"
                            FontSize="16"
                            WidthRequest="60"
                            HeightRequest="40"
                            BackgroundColor="#37474F"
                            TextColor="White"
                            CornerRadius="5"
                            ToolTipProperties.Text="Modèle précédent (flèche gauche du clavier)"
                            Clicked="OnModelePrecedentClicked" />
                    <Button x:Name="BtnModeleSuivant"
                            Grid.Column="1"
                            Text="&#x25B6;"
                            FontSize="16"
                            WidthRequest="60"
                            HeightRequest="40"
                            BackgroundColor="#37474F"
                            TextColor="White"
                            CornerRadius="5"
                            ToolTipProperties.Text="Modèle suivant (flèche droite du clavier)"
                            Clicked="OnModeleSuivantClicked" />
                    <Label x:Name="ModeleNavLabel"
                           Grid.Column="2"
                           Text=""
                           TextColor="#B0BEC5"
                           FontSize="13"
                           LineBreakMode="TailTruncation"
                           VerticalOptions="Center" />
                </Grid>

                <!-- Zone d'actions (Windows uniquement) -->
                <HorizontalStackLayout x:Name="WindowsActionsPanel" IsVisible="False" Spacing="10" HorizontalOptions="Start">
                    <Button x:Name="BtnCreerDossier" 
                            Text="📁 Créer le dossier" 
                            BackgroundColor="#2E7D32"
                            TextColor="White"
                            FontSize="14"
                            CornerRadius="5"
                            HeightRequest="40"
                            Padding="15,0"
                            IsVisible="False"
                            Clicked="OnCreerDossierClicked" />
                    <Button x:Name="BtnAjouterFichiers" 
                            Text="📎 Ajouter des fichiers" 
                            BackgroundColor="#1565C0"
                            TextColor="White"
                            FontSize="14"
                            CornerRadius="5"
                            HeightRequest="40"
                            Padding="15,0"
                            IsVisible="False"
                            Clicked="OnAjouterFichiersClicked" />
                    <Button x:Name="BtnRenommerModele" 
                            Text="✏ Renommer" 
                            BackgroundColor="#F57F17"
                            TextColor="White"
                            FontSize="14"
                            CornerRadius="5"
                            HeightRequest="40"
                            Padding="15,0"
                            IsVisible="False"
                            Clicked="OnRenommerModeleClicked" />
                    <Button x:Name="BtnTeleverserDossier"
                            Text="📦 Téléverser un dossier"
                            BackgroundColor="#00695C"
                            TextColor="White"
                            FontSize="14"
                            CornerRadius="5"
                            HeightRequest="40"
                            Padding="15,0"
                            IsVisible="False"
                            ToolTipProperties.Text="Copier un dossier déjà nommé (et tout son contenu) dans Famille &gt; Sujet"
                            Clicked="OnTeleverserDossierClicked" />
                    <Button x:Name="BtnOuvrirExplorateur" 
                            Text="📂 Ouvrir le dossier" 
                            BackgroundColor="#6A1B9A"
                            TextColor="White"
                            FontSize="14"
                            CornerRadius="5"
                            HeightRequest="40"
                            Padding="15,0"
                            IsVisible="False"
                            Clicked="OnOuvrirExplorateurClicked" />
        <Button x:Name="BtnActualiserBase"
                Text="🔄 Actualiser la base"
                BackgroundColor="#455A64"
                TextColor="White"
                FontSize="14"
                CornerRadius="5"
                HeightRequest="40"
                Padding="15,0"
                HorizontalOptions="Start"
                Clicked="OnActualiserBaseClicked" />
                </HorizontalStackLayout>

                <!-- Zone de dépôt (Windows) : glisser un ou plusieurs dossiers depuis
                     l'Explorateur, même effet que le bouton « Téléverser un dossier ».
                     Visible dans les mêmes conditions que ce bouton. -->
                <Border x:Name="ZoneDepotDossier"
                        IsVisible="False"
                        Stroke="#00695C"
                        StrokeThickness="2"
                        StrokeDashArray="6,4"
                        BackgroundColor="#1A2B29"
                        Padding="15,18"
                        HorizontalOptions="Fill"
                        MaximumWidthRequest="445">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <DropGestureRecognizer AllowDrop="True"
                                               DragOver="OnDossierDragOver"
                                               DragLeave="OnDossierDragLeave"
                                               Drop="OnDossierDrop" />
                    </Border.GestureRecognizers>
                    <!-- InputTransparent : le dépôt doit atterrir sur la bordure, pas sur le texte -->
                    <Label x:Name="ZoneDepotLabel"
                           InputTransparent="True"
                           Text="📂  … ou glissez un dossier ici pour le déplacer"
                           TextColor="#80CBC4"
                           FontSize="13"
                           HorizontalTextAlignment="Center" />
                </Border>

                <!-- Progression d'une copie de fichiers ou de dossier -->
                <Border x:Name="UploadProgressPanel"
                        IsVisible="False"
                        Stroke="#555"
                        StrokeThickness="1"
                        BackgroundColor="#1A3A5C"
                        Padding="15,10">
                    <VerticalStackLayout Spacing="5">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label x:Name="UploadPhaseLabel"
                                   Grid.Column="0"
                                   Text=""
                                   TextColor="#90CAF9"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation" />
                            <Label x:Name="UploadPercentLabel"
                                   Grid.Column="1"
                                   Text=""
                                   TextColor="#E0E0E0"
                                   FontSize="13"
                                   FontAttributes="Bold" />
                        </Grid>
                        <ProgressBar x:Name="UploadProgressBar" Progress="0" ProgressColor="#2196F3" />
                    </VerticalStackLayout>
                </Border>

                <!-- Contenu du dossier (fichiers et sous-dossiers à la racine) -->
                <Border x:Name="ContenuDossierPanel" IsVisible="False" Stroke="#555" StrokeThickness="1" BackgroundColor="#2D2D2D" Padding="10">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="📂 Contenu du dossier" FontSize="14" FontAttributes="Bold" TextColor="#E0E0E0" />
                        <CollectionView x:Name="ContenuDossierCollectionView" HeightRequest="100">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <!-- CharacterWrap : un nom de fichier long sans espace doit
                                         revenir à la ligne au lieu d'élargir la liste. -->
                                    <Label Text="{Binding .}" Padding="5,3" TextColor="#CCC" FontSize="13" LineBreakMode="CharacterWrap" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Fichiers 3D détectés (cliquables pour aperçu) -->
                <Border x:Name="Fichiers3DPanel" IsVisible="False" Stroke="#555" StrokeThickness="1" BackgroundColor="#2D2D2D" Padding="10">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="🧊 Fichiers 3D" FontSize="14" FontAttributes="Bold" TextColor="#E0E0E0" />
                        <CollectionView x:Name="Fichiers3DCollectionView" HeightRequest="120" SelectionMode="Single" SelectionChanged="OnFichier3DSelectionChanged">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <!-- Chemins d'archive du type « dossier/sous-dossier/piece.stl »
                                         sans espace : CharacterWrap évite qu'ils élargissent la liste. -->
                                    <Label Text="{Binding Affichage}" Padding="5,3" TextColor="#4FC3F7" FontSize="13" TextDecorations="Underline" LineBreakMode="CharacterWrap" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Zone de prévisualisation (image ou viewer 3D).
                     450 dp sur un téléphone d'environ 780 dp de haut, c'était plus de la
                     moitié de l'écran avant même le formulaire : réduite à 320 dp. -->
                <Border Stroke="#555"
                        StrokeThickness="1"
                        HeightRequest="{OnIdiom Phone=320, Default=450}"
                        HorizontalOptions="Fill" 
                        Margin="0,15,0,0"
                        BackgroundColor="#2D2D2D">
                    <Grid>
                        <Image x:Name="ModeleImage" Aspect="AspectFit" Margin="5">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnImageTapped" />
                            </Image.GestureRecognizers>
                        </Image>
                        <WebView x:Name="Viewer3DWebView" IsVisible="False" />
                    </Grid>
                </Border>

                <!-- Bouton retour aux images (visible quand le viewer 3D est actif) -->
                <Button x:Name="BtnRetourImages" 
                        Text="🖼 Retour aux images" 
                        BackgroundColor="#555" 
                        TextColor="White" 
                        FontSize="14" 
                        CornerRadius="5" 
                        HeightRequest="40" 
                        Padding="15,0" 
                        HorizontalOptions="Center"
                        IsVisible="False" 
                        Clicked="OnRetourImagesClicked" />

                <!-- Boutons de navigation des images.
                     Sur PC : 100 + 80 + 100 dp, comme avant. Sur téléphone, la rangée faisait
                     320 dp fixes pour ~328 dp disponibles une fois les marges déduites : elle
                     débordait dès que la taille d'affichage Android était un peu augmentée.
                     Réduite à 248 dp, elle garde de la marge. -->
                <HorizontalStackLayout x:Name="ImageNavPanel"
                                       HorizontalOptions="Center"
                                       Spacing="{OnIdiom Phone=12, Default=20}"
                                       Margin="0,10,0,0">
                    <Button x:Name="BtnImagePrecedente"
                            Text="&#x25C0;"
                            FontSize="24"
                            WidthRequest="{OnIdiom Phone=80, Default=100}"
                            HeightRequest="45"
                            BackgroundColor="#166286"
                            TextColor="White"
                            CornerRadius="5"
                            ToolTipProperties.Text="Image précédente (flèche haut du clavier)"
                            Clicked="OnImagePrecedenteClicked" />

                    <Label x:Name="ImageCounterLabel"
                           Text=""
                           TextColor="#E0E0E0"
                           FontSize="16"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           WidthRequest="{OnIdiom Phone=64, Default=80}"
                           HorizontalTextAlignment="Center" />

                    <Button x:Name="BtnImageSuivante"
                            Text="&#x25B6;"
                            FontSize="24"
                            WidthRequest="{OnIdiom Phone=80, Default=100}"
                            HeightRequest="45"
                            BackgroundColor="#166286"
                            TextColor="White"
                            CornerRadius="5"
                            ToolTipProperties.Text="Image suivante (flèche bas du clavier)"
                            Clicked="OnImageSuivanteClicked" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Panneau de log de debug (repliable) -->
        <Border x:Name="DebugLogPanel"
                Grid.Row="2"
                Stroke="#444"
                StrokeThickness="1"
                BackgroundColor="#1A1A2E"
                Padding="0">
            <VerticalStackLayout>
                <Grid Padding="10,6" BackgroundColor="#252542">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label Text="🐛 Journal de debug"
                           TextColor="#FFB74D"
                           FontSize="13"
                           FontAttributes="Bold"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleDebugLogClicked" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Button x:Name="BtnClearDebugLog"
                            Grid.Column="1"
                            Text="🗑"
                            FontSize="13"
                            TextColor="#888"
                            BackgroundColor="Transparent"
                            Padding="8,0"
                            Clicked="OnClearDebugLogClicked" />
                    <Button x:Name="BtnToggleDebugLog"
                            Grid.Column="2"
                            Text="▼"
                            FontSize="14"
                            TextColor="#FFB74D"
                            BackgroundColor="Transparent"
                            Padding="8,0"
                            Clicked="OnToggleDebugLogClicked" />
                </Grid>
                <ScrollView x:Name="DebugLogScrollView"
                            HeightRequest="180"
                            IsVisible="False">
                    <Label x:Name="DebugLogLabel"
                           Text=""
                           TextColor="#A5D6A7"
                           FontSize="11"
                           FontFamily="Consolas"
                           Padding="10,5"
                           LineBreakMode="WordWrap" />
                </ScrollView>
            </VerticalStackLayout>
        </Border>

        <!-- Overlay plein écran pour agrandir l'image (clic pour fermer) -->
        <Grid x:Name="ImageOverlay" Grid.RowSpan="3" IsVisible="False" BackgroundColor="#DD000000" ZIndex="100">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnImageOverlayTapped" />
            </Grid.GestureRecognizers>
            <Image x:Name="EnlargedImage" Aspect="AspectFit" Margin="30" />
            <Label Text="Cliquer pour fermer" 
                   TextColor="#AAA" 
                   FontSize="13" 
                   HorizontalOptions="Center" 
                   VerticalOptions="End" 
                   Margin="0,0,0,15" />
        </Grid>
    </Grid>

</ContentPage>
