<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Palette « atelier d'impression » : une seule apparence sombre.
         Android : voir aussi Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Fond">#1B1D1C</Color>        <!-- plan de travail -->
    <Color x:Key="Etabli">#252826</Color>      <!-- panneaux -->
    <Color x:Key="Champ">#2E3230</Color>       <!-- champs de saisie -->
    <Color x:Key="Rebord">#3A3F3C</Color>      <!-- traits -->
    <Color x:Key="Craie">#E9E6DE</Color>       <!-- texte -->
    <Color x:Key="Discret">#9AA39D</Color>     <!-- texte secondaire -->
    <Color x:Key="Ambre">#E3A23B</Color>       <!-- action principale, sélection -->
    <Color x:Key="AmbreTexte">#1B1D1C</Color>  <!-- texte posé sur l'ambre -->
    <Color x:Key="Resine">#6FB7D6</Color>      <!-- 3D, liens, progression -->
    <Color x:Key="ResineFond">#1F3640</Color>  <!-- bandeaux de progression -->
    <Color x:Key="Succes">#7FB88A</Color>
    <Color x:Key="Attention">#E3A23B</Color>
    <Color x:Key="Erreur">#E0705C</Color>
    <Color x:Key="PlateauFond">#161817</Color>
    <Color x:Key="Voile">#DD000000</Color>

    <SolidColorBrush x:Key="FondBrush" Color="{StaticResource Fond}"/>
    <SolidColorBrush x:Key="EtabliBrush" Color="{StaticResource Etabli}"/>
    <SolidColorBrush x:Key="RebordBrush" Color="{StaticResource Rebord}"/>
    <SolidColorBrush x:Key="AmbreBrush" Color="{StaticResource Ambre}"/>
    <SolidColorBrush x:Key="ResineBrush" Color="{StaticResource Resine}"/>
</ResourceDictionary>
