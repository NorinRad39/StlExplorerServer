<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Polices : Atkinson Hyperlegible Next pour le texte, Bricolage Grotesque pour les titres -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Fond}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Craie}" />
        <Setter Property="FontFamily" Value="TexteRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource Rebord}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="Titre" TargetType="Label">
        <Setter Property="FontFamily" Value="TitreBold" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="TitreSection" TargetType="Label">
        <Setter Property="FontFamily" Value="TitreBold" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="Secondaire" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Discret}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="Lien" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Resine}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Boutons : secondaire (contour) par défaut ; Principal = ambre ; Danger = rouge -->
    <Style x:Key="BoutonBase" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource Craie}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="{StaticResource Rebord}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="TexteBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource Discret}" />
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BorderColor" Value="{StaticResource Discret}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BoutonBase}" />

    <Style x:Key="Principal" TargetType="Button" BasedOn="{StaticResource BoutonBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource Ambre}" />
        <Setter Property="BorderColor" Value="{StaticResource Ambre}" />
        <Setter Property="TextColor" Value="{StaticResource AmbreTexte}" />
    </Style>

    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource BoutonBase}">
        <Setter Property="TextColor" Value="{StaticResource Erreur}" />
        <Setter Property="BorderColor" Value="#5A3A34" />
    </Style>

    <!-- Bouton discret sans cadre (✕, ▼, icônes) -->
    <Style x:Key="Discret" TargetType="Button" BasedOn="{StaticResource BoutonBase}">
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="TextColor" Value="{StaticResource Discret}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="0" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource Craie}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Discret}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="TexteRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource Rebord}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{StaticResource Etabli}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
    </Style>

    <!-- Champ de saisie : cadre de 40 de haut contenant un Entry -->
    <Style x:Key="Champ" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Champ}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource Resine}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Resine}" />
    </Style>

    <Style TargetType="CollectionView">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="SelectionMode" Value="None" />
    </Style>

    <Style TargetType="ScrollView">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="Color" Value="{StaticResource Rebord}" />
    </Style>

</ResourceDictionary>
