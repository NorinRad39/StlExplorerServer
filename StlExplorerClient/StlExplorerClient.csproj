<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>StlExplorerClient</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>StlExplorerClient</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.stlexplorerclient</ApplicationId>

		<!-- Versions : source de vérité pour les scripts de deploy\ et la mise à jour auto.
		     ApplicationVersion (versionCode Android) DOIT augmenter à chaque publication. -->
		<ApplicationDisplayVersion>1.1.12</ApplicationDisplayVersion>
		<ApplicationVersion>14</ApplicationVersion>

		<!-- Sur Windows en mode non empaquete, AppInfo.VersionString lit l'AssemblyVersion
		     de l'assembly d'entree. MAUI ne la derive pas d'ApplicationDisplayVersion : elle
		     restait a 1.0.0.0, et l'application se croyait donc perpetuellement obsolete,
		     reproposant sans fin une mise a jour deja installee. -->
		<AssemblyVersion>$(ApplicationDisplayVersion).0</AssemblyVersion>
		<FileVersion>$(ApplicationDisplayVersion).$(ApplicationVersion)</FileVersion>
		<Version>$(ApplicationDisplayVersion)</Version>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!--
		Publication Windows autonome (utilisee par deploy\deploy-windows.ps1 via
		-p:PublishStandalone=true). Ces proprietes sont volontairement definies ICI
		et non sur la ligne de commande : passees en global, RuntimeIdentifier et
		SelfContained se propagent aux TFM Android du projet partage, qui cherche
		alors un runtime Mono win-x64 inexistant (NU1102).
	-->
	<PropertyGroup Condition="'$(PublishStandalone)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<PublishSingleFile>false</PublishSingleFile>
	</PropertyGroup>

	<ItemGroup>
		<!-- Icone de l'application, derivee de ressource\icon.jpeg :
		     recadree au carre et fond blanc rendu transparent (voir le commentaire
		     du depot). Sert a la fois d'icone de fenetre, d'icone d'executable
		     (donc de raccourci Bureau) et d'icone de lanceur Android. -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" />

		<!-- Ecran de demarrage : meme badge que l'icone, sur le fond sombre de
		     l'application (#1E1E1E, celui de la page Catalogue). Le violet .NET
		     d'origine provoquait un flash clair avant l'ouverture de l'interface. -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#1E1E1E" BaseSize="256,256" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\ClassLibStlExploServ\ClassLibStlExploServ.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="ConfigPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

</Project>
