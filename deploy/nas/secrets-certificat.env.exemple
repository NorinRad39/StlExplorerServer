# ============================================================================
#  Modele de configuration pour renouveler-certificat.sh
#
#  A copier sur le NAS en /volume1/Applications/acme/secrets-certificat.env,
#  puis a remplir et proteger :
#      chmod 600 /volume1/Applications/acme/secrets-certificat.env
#
#  NE JAMAIS committer le fichier rempli : il contient un jeton d'API et un
#  mot de passe. Seul ce modele, sans valeurs, a sa place dans le depot.
# ============================================================================

# --- Cloudflare (challenge DNS-01) ------------------------------------------
# Jeton restreint, cree dans Cloudflare : My Profile > API Tokens > Create Token
# Permissions : Zone > DNS > Edit  ET  Zone > Zone > Read
# Ressources  : limitees a la zone file4all.fr
# (Utiliser un jeton restreint, surtout pas la Global API Key du compte.)
CF_Token=""

# Optionnel : uniquement si le jeton couvre plusieurs comptes.
#CF_Account_ID=""

# --- Compte DSM (import du certificat) --------------------------------------
# Compte membre du groupe "administrators".
SYNO_Username=""
SYNO_Password=""

# DESCRIPTION du certificat a remplacer dans DSM -- et non son domaine.
# Dans Panneau de configuration > Securite > Certificat, c'est le texte affiche
# sous le nom de domaine en gras.
#
# Laisser VIDE remplace le certificat par defaut : c'est le cas ici, la fiche
# affiche « (Certificat par defaut) », donc aucune description n'est definie.
# Le remplacer en place conserve toutes ses affectations de services
# (stl.file4all.fr, WebDAV, FTPS, ds923...).
SYNO_Certificate=""

# Creer le certificat dans DSM s'il n'existe pas encore.
SYNO_Create=1

# Adresse DSM vue depuis le NAS lui-meme : a laisser telle quelle en principe.
SYNO_Scheme="http"
SYNO_Hostname="localhost"
SYNO_Port="5000"

# Si la double authentification est activee sur le compte DSM, renseigner le
# secret TOTP (sinon l'import echouera) :
#SYNO_TOTP_SECRET=""

# --- Divers -----------------------------------------------------------------
# Adresse utilisee pour l'enregistrement du compte Let's Encrypt (alertes
# d'expiration envoyees par l'autorite).
ACME_EMAIL=""
